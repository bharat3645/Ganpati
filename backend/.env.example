# Copy this file to .env and fill in your own values.
# `backend/app.py` loads this automatically via python-dotenv.

# Hugging Face API token used for the FLUX.1-Kontext-dev image-to-image call.
# Get one at https://huggingface.co/settings/tokens (needs Inference API access).
# If left unset, the API still runs -- it just skips AI enhancement and
# returns the base composite image instead.
HF_TOKEN=

# Comma-separated list of allowed CORS origins for the frontend.
# Defaults to common local dev origins (Vite on 5173) if unset.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Rate limit on POST /api/generate (the expensive endpoint: rembg +
# optional AI call), per client IP. In-memory, per-process -- see the
# RateLimiter docstring in backend/app.py for the multi-worker caveat.
RATE_LIMIT_MAX_REQUESTS=10
RATE_LIMIT_WINDOW_SECONDS=60
